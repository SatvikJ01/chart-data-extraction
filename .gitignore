__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Downloaded model weights. checkpoints/ holds an ~800MB pytorch_model.bin;
# GitHub hard-rejects any blob over 100MB, so this must never be staged.
# The glob patterns are defence-in-depth for weights landing elsewhere.
checkpoints/
*.bin
*.zip
*.kaggle-partial

# Data and checkpoints are not versioned.
# Anchored with a leading slash: an unanchored 'data/' would also match
# chart_extraction/data/, which is source.
/data/
*.pth
*.ckpt
submission.csv

# Local path config (copy from the .example)
chart_extraction.paths.json
.venv/
.kaggle/
kaggle.json

# --- Not redistributable / not public ------------------------------------
# Third-party Kaggle notebooks are cited by name and URL in docs/PHASE0_AUDIT.md
# rather than vendored here; they are other authors' work. CLAUDE.md and the CV
# image are private working material. Listed so none of them return by accident.
CLAUDE.md
Old_cv_pointers.png
reference/
notebooks/
